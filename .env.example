# AWS Configuration
AWS_ACCESS_KEY_ID = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"
AWS_REGION = "us-east-1"
S3-BUCKET = "atlas-enterprise-ai-26-29"

# Bedrock Configuration
BEDROCK_EMBED_MODEL = amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL = amazon.nova-lite-v1:0
EMBED_DIMENSION = 1024

# Pinecone Vector Database Configuration
PINECONE_API_KEY = "YOUR_PINECONE_API_KEY"
PINECONE_INDEX_HOST = "atlas-enterprise-ai-index"
PINECONE_CLOUD = aws
PINECONE_REGION = us-east-1
PINECONE_READY_TIMEOUT = 180

# Postgres Configuration
DATABASE_URL = YOUR_DATABASE_URL

#RIUS Observability Configuration
RIUS_API_KEY = "YOUR_RIUS_API_KEY"
RIUS_SERVICE_NAME = "atlas-enterprise-ai"
RIUS_DISABLE = false
RIUS_CAPTURE_CONTENT = false

